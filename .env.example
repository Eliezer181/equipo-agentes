GEMINI_API_KEY=
MODEL=gemini-2.5-flash
HOST=127.0.0.1
PORT=8000

# LLM routing: gemini (default) | base44 (solo si Base44 está habilitado)
LLM_PROVIDER=base44

# Base44 Superagent (opcional, para turnos pesados). Nunca subir la key a git.
BASE44_ENABLED=1
BASE44_API_KEY=
BASE44_BASE_URL=
BASE44_TIMEOUT=60
